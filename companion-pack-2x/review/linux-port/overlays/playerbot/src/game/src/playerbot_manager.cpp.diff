+bool CPlayerBotManager::LoadCompanionRegistry()
 {
-	return LoadRegisteredBots() &&
-			m_setRegisteredBots.find(dwPlayerID) != m_setRegisteredBots.end();
+    if (m_bCompanionRegistryLoaded)
+        return true;
+
+    LoadRegisteredBots();
+
+    m_bCompanionRegistryLoaded = true;
+    m_mapCompanionsByOwner.clear();
+    m_mapOwnersByCompanion.clear();
+    m_mapCompanionEmpire.clear();
+
+    const char* query =
+        "SELECT c.owner_pid,c.companion_pid,pi.empire,a.id,a.login "
+        "FROM common.playerbot_companion AS c "
+        "JOIN player.player AS companion ON companion.id=c.companion_pid "
+        "JOIN account.account AS a ON a.id=companion.account_id "
+        "JOIN player.player_index AS pi ON pi.id=a.id "
+        "WHERE c.enabled=1 AND c.owner_pid<>c.companion_pid";
+
+    std::unique_ptr<SQLMsg> msg(AccountDB::instance().DirectQuery(query));
+
+    if (!msg.get() || msg->uiSQLErrno != 0 ||
+        !msg->Get() || !msg->Get()->pSQLResult)
+    {
+        sys_err("PLAYERBOT_COMPANION: registry query failed; companion spawns disabled");
+        return false;
+    }
+
+    MYSQL_ROW row;
+
+    while (NULL != (row = mysql_fetch_row(msg->Get()->pSQLResult)))
+    {
+        DWORD owner = 0;
+        DWORD companion = 0;
+        BYTE empire = 0;
+
+        if (row[0]) str_to_number(owner, row[0]);
+        if (row[1]) str_to_number(companion, row[1]);
+        if (row[2]) str_to_number(empire, row[2]);
+
+        if (owner && companion && empire)
+        {
+            m_mapCompanionsByOwner[owner] = companion;
+            m_mapOwnersByCompanion[companion] = owner;
+            m_mapCompanionEmpire[companion] = empire;
+
+            TPlayerBotAccount account;
+            account.dwID = 0;
+            account.bEmpire = empire;
+
+            if (row[3])
+                str_to_number(account.dwID, row[3]);
+
+            account.strLogin = row[4] ? row[4] : "";
+            m_mapBotAccounts[companion] = account;
+        }
+    }
+
+    sys_log(0,
+        "PLAYERBOT_COMPANION: loaded %u companion relationship(s)",
+        (unsigned int)m_mapCompanionsByOwner.size());
+
+    return true;
+}
