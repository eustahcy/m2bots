+DWORD CPlayerBotManager::GetCompanionOwner(DWORD companionPID) const
+{
+    std::map<DWORD, DWORD>::const_iterator it =
+        m_mapOwnersByCompanion.find(companionPID);
+
+    return it == m_mapOwnersByCompanion.end() ? 0 : it->second;
+}
