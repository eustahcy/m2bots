+void CPlayerBotManager::OnOwnerEnteredGame(LPCHARACTER ch)
+{
+    if (!ch || !ch->IsPC() || !LoadCompanionRegistry())
+        return;
+
+    const DWORD ownerPID = ch->GetPlayerID();
+
+    std::map<DWORD, DWORD>::iterator it =
+        m_mapCompanionsByOwner.find(ownerPID);
+
+    if (it == m_mapCompanionsByOwner.end())
+        return;
+
+    const DWORD companionPID = it->second;
+
+    LPCHARACTER companion =
+        CHARACTER_MANAGER::instance().FindByPID(companionPID);
+
+    if (companion)
+    {
+        if (!companion->GetDesc() || !companion->GetDesc()->IsBot())
+            return;
+
+        float dx = 0.0f;
+        float dy = 0.0f;
+
+        GetDeltaByDegree(
+            ch->GetRotation() + 180.0f,
+            350.0f,
+            &dx,
+            &dy);
+
+        const long x = ch->GetX() + (long)dx;
+        const long y = ch->GetY() + (long)dy;
+
+        companion->SetVictim(NULL);
+        companion->Stop();
+
+        std::map<DWORD, TPlayerBotAIState>::iterator stateIt =
+            s_mapPlayerBotAIStates.find(companionPID);
+
+        if (stateIt != s_mapPlayerBotAIStates.end())
+        {
+            stateIt->second.dwTargetVID = 0;
+            ClearPlayerBotRoute(stateIt->second, true);
+        }
+
+        companion->Show(
+            ch->GetMapIndex(),
+            x,
+            y,
+            0);
+
+        sys_log(0,
+            "PLAYERBOT_COMPANION: relocated existing companion owner_pid=%u companion_pid=%u map=%ld x=%ld y=%ld",
+            ownerPID,
+            companionPID,
+            ch->GetMapIndex(),
+            x,
+            y);
+
+        return;
+    }
+
+    if (IsManaged(companionPID))
+        return;
+
+    std::map<DWORD, BYTE>::iterator empireIt =
+        m_mapCompanionEmpire.find(companionPID);
+
+    if (empireIt == m_mapCompanionEmpire.end() ||
+        empireIt->second == 0)
+    {
+        sys_err(
+            "PLAYERBOT_COMPANION: no valid empire for companion pid=%u owner=%u",
+            companionPID,
+            ownerPID);
+        return;
+    }
+
+    const BYTE empire = empireIt->second;
+
+    if (Spawn(companionPID, empire))
+    {
+        sys_log(0,
+            "PLAYERBOT_COMPANION: owner=%u requested companion spawn pid=%u empire=%u",
+            ownerPID,
+            companionPID,
+            empire);
+    }
+    else
+    {
+        sys_err(
+            "PLAYERBOT_COMPANION: owner=%u failed to request companion spawn pid=%u empire=%u",
+            ownerPID,
+            companionPID,
+            empire);
+    }
+}
+void CPlayerBotManager::OnOwnerAttack(
+        LPCHARACTER owner,
+        LPCHARACTER target)
+{
+        if (!owner || !target || !owner->IsPC())
+                return;
+
+        if (!target->IsMonster() && !target->IsStone())
+                return;
+
+        if (!LoadCompanionRegistry())
+                return;
+
+        const DWORD ownerPID = owner->GetPlayerID();
+
+        if (m_mapCompanionsByOwner.find(ownerPID) ==
+            m_mapCompanionsByOwner.end())
+                return;
+
+        m_mapCompanionOwnerTargetVID[ownerPID] =
+                target->GetVID();
+
+        m_mapCompanionOwnerAttackTime[ownerPID] =
+                get_dword_time();
+
+        sys_log(0,
+                "PLAYERBOT_COMPANION: owner attack owner_pid=%u target_vid=%u",
+                ownerPID,
+                target->GetVID());
 }
+bool CPlayerBotManager::IsRegistered(DWORD dwPlayerID)
+{
+    if (LoadRegisteredBots() &&
+        m_setRegisteredBots.find(dwPlayerID) != m_setRegisteredBots.end())
+        return true;
 
+    LoadCompanionRegistry();
+
+    return m_mapOwnersByCompanion.find(dwPlayerID) !=
+        m_mapOwnersByCompanion.end();
+}
