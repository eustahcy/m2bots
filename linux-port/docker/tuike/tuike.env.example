# Tuike - przykładowa konfiguracja dla uruchomienia samodzielnego.
#
# W stacku z docker-compose.yml tego repozytorium nic z tego pliku nie jest
# potrzebne: usługi `tuike`, `tuike-collector` i `tuike-grants` dostają te
# zmienne z głównego .env. Ten plik jest dla instalacji, w której panel stoi
# osobno, obok cudzego serwera.
#
# Skopiuj do tuike.env i nie commituj kopii.

# --- baza danych -------------------------------------------------------------
DB_HOST=metin2-db
DB_PORT=3306
DB_USER=metin2
DB_PASSWORD=wpisz-haslo-do-bazy

# --- świat, na który panel patrzy --------------------------------------------
# mt2009 albo r40250. Decyduje o numeracji bonusów przedmiotów, obecności
# kolumny empire na koncie i długości loginu.
PLAYERBOTS_ENGINE=mt2009
PLAYERBOTS_GAME_HOST=metin2-game
PLAYERBOTS_LOGIN_PORT=11000
PLAYERBOTS_WORLD_PORT=13000
# Gdzie w kontenerze panelu leżą pliki statusu botów.
PLAYERBOTS_STATUS_GLOB=/opt/metin2/var/channel1/*/playerbot_status.tsv
# Wersja zainstalowanego wydania, pokazywana na pulpicie.
PLAYERBOTS_VERSION=2.0.23

# --- panel -------------------------------------------------------------------
TUIKE_PANEL_PORT=7799
# Długi, losowy ciąg. Wygeneruj: openssl rand -hex 32
TUIKE_SESSION_SECRET=zmien-to-przed-wystawieniem-na-swiat
# Co ile sekund kolektor zapisuje migawkę.
TUIKE_COLLECTOR_INTERVAL=300
# 0 wyłącza jedyne połączenie wychodzące panelu (sprawdzanie wydań na GitHub).
TUIKE_UPDATE_CHECK=1

# --- odnośniki widoczne w menu -----------------------------------------------
# Adresy otwierane przez przeglądarkę odwiedzającego, więc nie nazwy kontenerów.
# Z TIERU_PANEL_URL panel pobiera też ikony umiejętności.
TIERU_PANEL_URL=http://adres-serwera:7788
TUIKE_SEBAN_PANEL_URL=http://adres-serwera:7790

# --- kolejki dzielone z kontenerem gry ---------------------------------------
# Te same katalogi, których używa panel klasyczny. Zmieniaj tylko, jeśli
# montujesz je gdzie indziej.
TUIKE_RATES_SPOOL=/opt/m2spool
TUIKE_UPDATE_SPOOL=/opt/m2update
